<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>WappaiPushEnvironment</key><string>$(WAPPAI_PUSH_ENVIRONMENT)</string>
    <key>ITSAppUsesNonExemptEncryption</key><false/>
	<key>CFBundleDisplayName</key>
	<string>Wappai</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Wappai משתמש ב־Bluetooth כדי לשייך את המכשיר שלך ולהגדיר את רשת ה־Wi‑Fi שלו.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>חיבור מאובטח למכשיר ולשרת Wappai ברשת שלך.</string>
</dict>
</plist>
