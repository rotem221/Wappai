[Unit]
Description=Waveshare Companion brain server
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
User=companion
WorkingDirectory=/opt/companion/server
Environment=COMPANION_ENV=/etc/companion.env
Environment=PATH=/home/companion/.local/bin:/opt/companion/venv/bin:/usr/bin:/bin
ExecStart=/opt/companion/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8770 --ws-max-size 4194304 --proxy-headers --no-access-log
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
