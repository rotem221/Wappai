# Add to the private Hub environment. Never commit credentials.
MEETING_QUOTA_MB=4096
MEETING_RESERVE_MB=256
# Optional private S3-compatible bucket. Use credentials scoped only to this bucket.
MEETING_S3_BUCKET=
MEETING_S3_ENDPOINT=
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Opt-in removal of local audio only after final cloud verification. Default keeps local files.
MEETING_CLOUD_EVICT=0
# APNs: only on the app publisher's protected Hub/service. Never bundle these in a user installer.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_KEY_FILE=
APNS_TOPIC=com.dadon.wappai
# Recommended for newly issued Apple keys: separate, Wappai-topic-scoped keys.
# Legacy APNS_KEY_ID / APNS_KEY_FILE remain supported for existing dual-environment keys.
# If either scoped value is set, both are required; no fallback to the legacy key.
APNS_SANDBOX_KEY_ID=
APNS_SANDBOX_KEY_FILE=
APNS_PRODUCTION_KEY_ID=
APNS_PRODUCTION_KEY_FILE=
